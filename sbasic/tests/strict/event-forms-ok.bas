REM all of these load
DECLARE SUB s ()
ON TIMER(5) GOSUB 100
ON KEY(25) GOSUB 100
ON PLAY(4) GOSUB 100
ON STRIG(2) GOSUB 100
ON PEN GOSUB 100
ON TIMER(1) GOSUB 0
TIMER ON: TIMER OFF: TIMER STOP
KEY(1) ON: KEY(1) OFF: KEY(1) STOP
PLAY ON: PLAY OFF: PLAY STOP
STRIG(0) ON: STRIG(0) OFF: STRIG(0) STOP
PEN ON: PEN OFF: PEN STOP
KEY ON: KEY OFF: KEY LIST
KEY 15, CHR$(0) + CHR$(1)
PRINT TIMER; PEN(0); STRIG(0); PLAY(0)
s
SYSTEM
100 RETURN
SUB s
ON TIMER(1) GOSUB 100
END SUB
