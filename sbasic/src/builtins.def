/* builtins.def -- every builtin function: its name, its C function in
 * builtin.c, and the arguments it takes (at least, at most; -1 any
 * number), the counts it checks when it runs.  One list for two users:
 * builtin.c's table of functions, and builtin_names.c's of names and
 * counts, which the checker (strict.c) and s32-bc link without the rest
 * of the interpreter.
 *
 *   #define BUILTIN(name, fn, min, max) ...
 *   #include "builtins.def"
 */
/* Math */
BUILTIN("ABS", fn_abs, 1, 1)
BUILTIN("INT", fn_int, 1, 1)
BUILTIN("SGN", fn_sgn, 1, 1)
BUILTIN("SQR", fn_sqr, 1, 1)
BUILTIN("FIX", fn_fix, 1, 1)
BUILTIN("CINT", fn_cint, 1, 1)
BUILTIN("CLNG", fn_clng, 1, 1)
BUILTIN("CDBL", fn_cdbl, 1, 1)
BUILTIN("CSNG", fn_csng, 1, 1)
BUILTIN("SIN", fn_sin, 1, 1)
BUILTIN("COS", fn_cos, 1, 1)
BUILTIN("TAN", fn_tan, 1, 1)
BUILTIN("ATN", fn_atn, 1, 1)
BUILTIN("ATN2", fn_atn2, 2, 2)
BUILTIN("ASIN", fn_asin, 1, 1)
BUILTIN("ACOS", fn_acos, 1, 1)
BUILTIN("SINH", fn_sinh, 1, 1)
BUILTIN("COSH", fn_cosh, 1, 1)
BUILTIN("TANH", fn_tanh, 1, 1)
BUILTIN("ASINH", fn_asinh, 1, 1)
BUILTIN("ACOSH", fn_acosh, 1, 1)
BUILTIN("ATANH", fn_atanh, 1, 1)
BUILTIN("EXP", fn_exp, 1, 1)
BUILTIN("LOG", fn_log, 1, 1)
BUILTIN("LOG10", fn_log10, 1, 1)
BUILTIN("LOG2", fn_log2, 1, 1)
BUILTIN("ROUND", fn_round, 1, 2)
BUILTIN("MIN", fn_min, 2, -1)
BUILTIN("MAX", fn_max, 2, -1)
BUILTIN("FLOOR", fn_floor, 1, -1)
BUILTIN("CEIL", fn_ceil, 1, -1)
BUILTIN("RND", fn_rnd, 0, 1)
BUILTIN("TIMER", fn_timer, 0, 0)
BUILTIN("DATE$", fn_date, 0, 0)
BUILTIN("TIME$", fn_time_str, 0, 0)
BUILTIN("TAB", fn_tab, 1, 1)
BUILTIN("SPC", fn_spc, 1, 1)
/* String */
BUILTIN("LEN", fn_len, 1, 1)
BUILTIN("CHR$", fn_chr, 1, 1)
BUILTIN("ASC", fn_asc, 1, 1)
BUILTIN("STR$", fn_str, 1, 1)
BUILTIN("VAL", fn_val, 1, 1)
BUILTIN("LEFT$", fn_left, 2, 2)
BUILTIN("RIGHT$", fn_right, 2, 2)
BUILTIN("MID$", fn_mid, 2, 3)
BUILTIN("INSTR", fn_instr, 2, 3)
BUILTIN("INSTRREV", fn_instrrev, 2, 3)
BUILTIN("UCASE$", fn_ucase, 1, 1)
BUILTIN("LCASE$", fn_lcase, 1, 1)
BUILTIN("LTRIM$", fn_ltrim, 1, 1)
BUILTIN("RTRIM$", fn_rtrim, 1, 1)
BUILTIN("TRIM$", fn_trim, 1, 1)
BUILTIN("SPACE$", fn_space, 1, 1)
BUILTIN("STRING$", fn_string, 2, 2)
BUILTIN("HEX$", fn_hex, 1, 1)
BUILTIN("OCT$", fn_oct, 1, 1)
BUILTIN("BIN$", fn_bin, 1, 1)
BUILTIN("REPLACE$", fn_replace, 3, 3)
BUILTIN("REVERSE$", fn_reverse, 1, -1)
/* Binary packing */
BUILTIN("MKI$", fn_mki, 1, 1)
BUILTIN("MKL$", fn_mkl, 1, 1)
BUILTIN("MKS$", fn_mks, 1, 1)
BUILTIN("MKD$", fn_mkd, 1, 1)
BUILTIN("CVI", fn_cvi, 1, 1)
BUILTIN("CVL", fn_cvl, 1, 1)
BUILTIN("CVS", fn_cvs, 1, 1)
BUILTIN("CVD", fn_cvd, 1, 1)
/* File I/O */
BUILTIN("EOF", fn_eof, 1, 1)
BUILTIN("FREEFILE", fn_freefile, 0, 0)
BUILTIN("LOC", fn_loc, 1, 1)
BUILTIN("LOF", fn_lof, 1, 1)
BUILTIN("CSRLIN", fn_csrlin, 0, 0)
BUILTIN("POS", fn_pos, 1, 1)
BUILTIN("INPUT$", fn_input_str, 1, 2)
/* System */
BUILTIN("ENVIRON$", fn_environ, 1, 1)
BUILTIN("COMMAND$", fn_command, 0, 1)
BUILTIN("INKEY$", fn_inkey, 0, 0)
BUILTIN("DIR$", fn_dir, 0, 1)
BUILTIN("CURDIR$", fn_curdir, 0, 0)
BUILTIN("FILEEXISTS", fn_fileexists, 1, 1)
BUILTIN("FRE", fn_fre, 1, 1)
BUILTIN("LPOS", fn_lpos, 1, 1)
BUILTIN("INP", fn_inp, 1, 1)
BUILTIN("VARPTR", fn_varptr, 1, 1)
BUILTIN("VARSEG", fn_varptr, 1, 1)
BUILTIN("SADD", fn_sadd, 1, 1)
BUILTIN("SEEK", fn_seek, 1, 1)
BUILTIN("PEEK", fn_peek, 1, 1)
BUILTIN("STRIG", fn_strig, 1, 1)
BUILTIN("STICK", fn_stick, 1, 1)
BUILTIN("POINT", fn_point, 2, 2)
BUILTIN("PMAP", fn_pmap, 2, 2)
