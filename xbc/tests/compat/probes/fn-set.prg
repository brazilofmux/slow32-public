* Functions: SET() by set.ch's numbering, typed as Clipper types it
#include "set.ch"
LOCAL d := CTOD("03/04/2025")
? SET(_SET_DECIMALS), SET(_SET_EXACT), SET(_SET_DELETED), SET(_SET_WRAP), SET(_SET_EPOCH)
? SET(_SET_DATEFORMAT), SET(_SET_MARGIN), SET(_SET_TYPEAHEAD), SET(_SET_DELIMCHARS)
? SET(_SET_DECIMALS, 4), 10 / 4
? SET(_SET_EXACT, .T.), SET(_SET_EXACT), "ab" = "a"
? SET(_SET_DATEFORMAT, "dd.mm.yyyy"), DTOC(d), SET(_SET_DATEFORMAT)
SET(_SET_DATEFORMAT, "mm/dd/yy")
? DTOC(d), SET(_SET_EPOCH, 1950), SET(_SET_EPOCH)
? SET(_SET_SCOREBOARD, .F.), SET(_SET_SCOREBOARD), SET(_SET_INTENSITY)
? SET(_SET_DEVICE), SET(_SET_MARGIN, 7), SET(_SET_MARGIN)
SET TYPEAHEAD TO 20
? SET(_SET_TYPEAHEAD), SET(_SET_TYPEAHEAD, 64), SET(_SET_TYPEAHEAD)
