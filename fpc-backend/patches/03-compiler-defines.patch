diff --git a/compiler/options.pas b/compiler/options.pas
index 1178acbcc9..94948b8ed1 100644
--- a/compiler/options.pas
+++ b/compiler/options.pas
@@ -4850,6 +4850,14 @@ procedure read_arguments(cmd:TCmdStr);
         def_system_macro('FPC_LOCALS_ARE_STACK_REG_RELATIVE');
       {$endif loongarch64}
 
+      {$ifdef slow32}
+        def_system_macro('CPUSLOW32');
+        def_system_macro('CPU32');
+        def_system_macro('FPC_CURRENCY_IS_INT64');
+        def_system_macro('FPC_COMP_IS_INT64');
+        def_system_macro('FPC_REQUIRES_PROPER_ALIGNMENT');
+      {$endif slow32}
+
       {$if defined(cpu8bitalu)}
         def_system_macro('CPUINT8');
       {$elseif defined(cpu16bitalu)}
@@ -5735,6 +5743,19 @@ procedure read_arguments(cmd:TCmdStr);
       ;
   end;
 {$endif mipsel}
+{$ifdef slow32}
+  { Default to fpu_soft so the softfpu RTL unit compiles cleanly (it does
+    bit-pattern arithmetic on records that must NOT emit native FADD/etc.).
+    Opt in to native f32 instructions per-translation-unit with -CfSLOW32. }
+  if not option.FPUSetExplicitly then
+    init_settings.fputype:=fpu_soft;
+  if init_settings.fputype=fpu_soft then
+    include(init_settings.moduleswitches,cs_fp_emulation)
+  else
+    { fpu_slow32 emits native FP instructions; clear cs_fp_emulation so
+      def_cgsize maps floatdef to OS_F32/F64 (see defutil.pas:1761). }
+    exclude(init_settings.moduleswitches,cs_fp_emulation);
+{$endif slow32}
 {$ifdef m68k}
   if init_settings.cputype in cpu_coldfire then
     def_system_macro('CPUCOLDFIRE');
