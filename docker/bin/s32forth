#!/bin/bash
# s32forth -- the SLOW-32 DTC Forth kernel with the prelude loaded.
#   s32forth [file.fth ...]      loads the files, then reads stdin
#   podman run -i ... s32forth   an interactive session
# EMU selects the engine (default slow32-fast; slow32-dbt is faster still).
EMU="${EMU:-slow32-fast}"
# Through a FIFO, not a pipe: `cat - | emu` would leave cat reading stdin
# after the kernel exits on BYE, and the container would not end until EOF.
fifo="$(mktemp -u /tmp/forth.XXXXXX)"
mkfifo "$fifo"
# exec: the subshell becomes the stdin reader, so the kill reaches it.
# <&3: background jobs get /dev/null as stdin unless explicitly
# redirected; hand the reader the real one (the -i/-it stdin).
exec 3<&0
( cat /opt/slow32/forth/prelude.fth "$@"; exec cat ) <&3 > "$fifo" &
feeder=$!
trap 'kill "$feeder" 2>/dev/null || true; rm -f "$fifo"' EXIT
"$EMU" /opt/slow32/forth/kernel.s32x < "$fifo"
