#!/bin/bash
# cc-a64 — compile a C file to a native arm64 Linux ELF using the self-hosted
# SLOW-32 cross-compiler (cc-a64 + ld-a64 + libc_a64). The output is an
# arm64 binary (runs on an arm64 host or under qemu), NOT a .s32x.
#
# Usage: cc-a64 <input.c> [output]  or  cc-a64 <input.c> -o <output>
#        (output defaults to input basename, no ext)
set -e
TOOLS="${SLOW32_A64_TOOLS:-/opt/slow32/a64}"
usage() { echo "Usage: cc-a64 <input.c> [output]  or  cc-a64 <input.c> -o <output>" >&2; exit 1; }
IN=""; OUT=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o) [ $# -ge 2 ] || usage; OUT="$2"; shift ;;
        -*) echo "cc-a64: unknown option $1" >&2; usage ;;
        *) if [ -z "$IN" ]; then IN="$1"; elif [ -z "$OUT" ]; then OUT="$1"; else usage; fi ;;
    esac
    shift
done
[ -n "$IN" ] || usage
OUT="${OUT:-$(basename "${IN%.c}")}"
OBJ="$(mktemp)"
trap 'rm -f "$OBJ"' EXIT
"$TOOLS/cc-a64" --hir -c "$IN" -o "$OBJ"
"$TOOLS/ld-a64" -o "$OUT" "$TOOLS/crt0.o" "$OBJ" "$TOOLS/libc_a64.a"
echo "cc-a64: wrote $OUT (arm64 ELF)"
