// -*- C++ -*-
// <__external_threading> -- libc++'s thread support for SLOW-32, which has
// exactly one thread.  libc++ is built with LIBCXX_HAS_EXTERNAL_THREAD_API
// (scripts/build-libcxx.sh) and includes this from <__thread/support.h>; it
// is found here because runtime/include follows libc++'s headers on every
// include path.
//
// One thread makes most of the contract trivial, and nothing here pretends:
//   - a mutex is a count.  Locking one already held by the only thread there
//     is would deadlock anywhere else; here a plain mutex that is held fails
//     trylock, and lock returns EDEADLK rather than hang.  A recursive mutex
//     counts its depth.
//   - a condition variable cannot be signalled by anyone else, so a wait
//     returns at once -- a spurious wakeup, which the standard permits and
//     every correct caller loops on -- and a timed wait sleeps to its
//     deadline and reports ETIMEDOUT.
//   - creating a thread fails with EAGAIN (std::thread throws
//     std::system_error, resource_unavailable_try_again), as a system out
//     of threads would.
//   - this_thread::sleep_for is nanosleep; yield has no one to yield to.
//   - thread-specific storage is a small table, its destructors never run
//     (they would run at thread exit, and the one thread exits the process).
//
// The functions are inline so the header is the whole implementation: libc++
// and every program that includes it agree without a library to link.

#ifndef _SLOW32_EXTERNAL_THREADING
#define _SLOW32_EXTERNAL_THREADING

#include <__chrono/convert_to_timespec.h>
#include <__chrono/duration.h>
#include <__config>
#include <errno.h>
#include <time.h>

#ifndef _LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER
#  pragma GCC system_header
#endif

_LIBCPP_BEGIN_NAMESPACE_STD

using __libcpp_timespec_t = ::timespec;

// Mutex
struct __libcpp_mutex_t {
  unsigned __held;
};
#define _LIBCPP_MUTEX_INITIALIZER {0}

struct __libcpp_recursive_mutex_t {
  unsigned __depth;
};

inline _LIBCPP_HIDE_FROM_ABI int __libcpp_recursive_mutex_init(__libcpp_recursive_mutex_t* __m) {
  __m->__depth = 0;
  return 0;
}
_LIBCPP_NO_THREAD_SAFETY_ANALYSIS inline _LIBCPP_HIDE_FROM_ABI int
__libcpp_recursive_mutex_lock(__libcpp_recursive_mutex_t* __m) {
  ++__m->__depth;
  return 0;
}
_LIBCPP_NO_THREAD_SAFETY_ANALYSIS inline _LIBCPP_HIDE_FROM_ABI bool
__libcpp_recursive_mutex_trylock(__libcpp_recursive_mutex_t* __m) {
  ++__m->__depth;
  return true;
}
_LIBCPP_NO_THREAD_SAFETY_ANALYSIS inline _LIBCPP_HIDE_FROM_ABI int
__libcpp_recursive_mutex_unlock(__libcpp_recursive_mutex_t* __m) {
  if (__m->__depth == 0)
    return EPERM;
  --__m->__depth;
  return 0;
}
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_recursive_mutex_destroy(__libcpp_recursive_mutex_t*) { return 0; }

_LIBCPP_NO_THREAD_SAFETY_ANALYSIS inline _LIBCPP_HIDE_FROM_ABI int __libcpp_mutex_lock(__libcpp_mutex_t* __m) {
  if (__m->__held)
    return EDEADLK;
  __m->__held = 1;
  return 0;
}
_LIBCPP_NO_THREAD_SAFETY_ANALYSIS inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_mutex_trylock(__libcpp_mutex_t* __m) {
  if (__m->__held)
    return false;
  __m->__held = 1;
  return true;
}
_LIBCPP_NO_THREAD_SAFETY_ANALYSIS inline _LIBCPP_HIDE_FROM_ABI int __libcpp_mutex_unlock(__libcpp_mutex_t* __m) {
  if (!__m->__held)
    return EPERM;
  __m->__held = 0;
  return 0;
}
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_mutex_destroy(__libcpp_mutex_t*) { return 0; }

// Condition variable
struct __libcpp_condvar_t {
  unsigned __unused;
};
#define _LIBCPP_CONDVAR_INITIALIZER {0}

inline _LIBCPP_HIDE_FROM_ABI int __libcpp_condvar_signal(__libcpp_condvar_t*) { return 0; }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_condvar_broadcast(__libcpp_condvar_t*) { return 0; }
_LIBCPP_NO_THREAD_SAFETY_ANALYSIS inline _LIBCPP_HIDE_FROM_ABI int
__libcpp_condvar_wait(__libcpp_condvar_t*, __libcpp_mutex_t*) {
  return 0;  // a spurious wakeup: nobody else can signal
}
_LIBCPP_NO_THREAD_SAFETY_ANALYSIS inline _LIBCPP_HIDE_FROM_ABI int
__libcpp_condvar_timedwait(__libcpp_condvar_t*, __libcpp_mutex_t* __m, __libcpp_timespec_t* __ts) {
  // __ts is an absolute CLOCK_REALTIME deadline (pthread_cond_timedwait's).
  // The mutex is released while asleep, as a wait releases it.
  unsigned __held = __m->__held;
  __m->__held = 0;
  ::timespec __now;
  if (::clock_gettime(CLOCK_REALTIME, &__now) == 0) {
    long long __ns = (static_cast<long long>(__ts->tv_sec) - static_cast<long long>(__now.tv_sec)) * 1000000000LL +
                     (__ts->tv_nsec - __now.tv_nsec);
    if (__ns > 0) {
      ::timespec __d;
      __d.tv_sec  = static_cast<time_t>(__ns / 1000000000LL);
      __d.tv_nsec = static_cast<long>(__ns % 1000000000LL);
      ::nanosleep(&__d, nullptr);
    }
  }
  __m->__held = __held;
  return ETIMEDOUT;
}
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_condvar_destroy(__libcpp_condvar_t*) { return 0; }

// Execute once.  The routine may throw: the flag is set only once it returns.
typedef int __libcpp_exec_once_flag;
#define _LIBCPP_EXEC_ONCE_INITIALIZER 0

inline _LIBCPP_HIDE_FROM_ABI int __libcpp_execute_once(__libcpp_exec_once_flag* __flag, void (*__init_routine)()) {
  if (*__flag == 0) {
    __init_routine();
    *__flag = 1;
  }
  return 0;
}

// Thread id: the one thread is 1; 0 is no thread.
typedef unsigned long __libcpp_thread_id;

inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_thread_id_equal(__libcpp_thread_id __a, __libcpp_thread_id __b) {
  return __a == __b;
}
inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_thread_id_less(__libcpp_thread_id __a, __libcpp_thread_id __b) {
  return __a < __b;
}

// Thread
#define _LIBCPP_NULL_THREAD 0UL
typedef unsigned long __libcpp_thread_t;

inline _LIBCPP_HIDE_FROM_ABI bool __libcpp_thread_isnull(const __libcpp_thread_t* __t) { return *__t == 0; }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_thread_create(__libcpp_thread_t*, void* (*)(void*), void*) {
  return EAGAIN;
}
inline _LIBCPP_HIDE_FROM_ABI __libcpp_thread_id __libcpp_thread_get_current_id() { return 1; }
inline _LIBCPP_HIDE_FROM_ABI __libcpp_thread_id __libcpp_thread_get_id(const __libcpp_thread_t* __t) { return *__t; }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_thread_join(__libcpp_thread_t*) { return EINVAL; }
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_thread_detach(__libcpp_thread_t*) { return EINVAL; }
inline _LIBCPP_HIDE_FROM_ABI void __libcpp_thread_yield() {}
inline _LIBCPP_HIDE_FROM_ABI void __libcpp_thread_sleep_for(const chrono::nanoseconds& __ns) {
  __libcpp_timespec_t __ts = std::__convert_to_timespec<__libcpp_timespec_t>(__ns);
  while (::nanosleep(&__ts, &__ts) == -1 && errno == EINTR) {
  }
}

// Thread-specific storage
#define _LIBCPP_TLS_DESTRUCTOR_CC /* nothing */
typedef unsigned __libcpp_tls_key;

inline _LIBCPP_HIDE_FROM_ABI void** __slow32_tls_slots() {
  static void* __slots[16];
  return __slots;
}
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_tls_create(__libcpp_tls_key* __key, void (*)(void*)) {
  static unsigned __next = 0;
  if (__next >= 16)
    return EAGAIN;
  *__key = __next++;
  return 0;
}
inline _LIBCPP_HIDE_FROM_ABI void* __libcpp_tls_get(__libcpp_tls_key __key) {
  return __key < 16 ? __slow32_tls_slots()[__key] : nullptr;
}
inline _LIBCPP_HIDE_FROM_ABI int __libcpp_tls_set(__libcpp_tls_key __key, void* __p) {
  if (__key >= 16)
    return EINVAL;
  __slow32_tls_slots()[__key] = __p;
  return 0;
}

_LIBCPP_END_NAMESPACE_STD

#endif // _SLOW32_EXTERNAL_THREADING
