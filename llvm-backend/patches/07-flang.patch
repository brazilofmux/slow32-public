+//===-- include/flang/Runtime/api-int64.h -----------------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+// The runtime's interfaces say std::int64_t for what is 64 bits on any target
+// and std::size_t or a subscript for what follows the target.  The compiler
+// reads these headers to model those interfaces, by C++ type.  On an LP64 host
+// int64_t and ptrdiff_t are both long, and the two meanings could not be told
+// apart for a target whose long is not 64 bits.  So the compiler sees long long.
+// The runtime itself (FLANG_RT_BUILD) sees what it has always seen.
+
+#ifndef FORTRAN_RUNTIME_API_INT64_H_
+#define FORTRAN_RUNTIME_API_INT64_H_
+
+#include <cstdint>
+
+#ifdef FLANG_RT_BUILD
+#define RT_API_INT64 std::int64_t
+#define RT_API_UINT64 std::uint64_t
+#else
+#define RT_API_INT64 long long
+#define RT_API_UINT64 unsigned long long
+#endif
+
+#endif // FORTRAN_RUNTIME_API_INT64_H_
