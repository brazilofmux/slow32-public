 /// Returns size in bytes of the descriptor (not the data)
 /// This must be at least as large as the largest descriptor of any target
 /// triple.
+/// The same layout on a target whose pointers, size_t and CFI_index_t are
+/// pointerBytes wide; length parameters are 8 bytes on any target.
+static constexpr RT_API_ATTRS std::size_t DescriptorSizeInBytes(
+    std::size_t pointerBytes, int rank, bool addendum = false,
+    int lengthTypeParameters = 0) {
+  std::size_t bytes{2u * pointerBytes + 8u + rank * 3u * pointerBytes};
+  if (addendum || lengthTypeParameters > 0) {
+    if (lengthTypeParameters < 1)
+      lengthTypeParameters = 1;
+    bytes += pointerBytes + static_cast<std::size_t>(lengthTypeParameters) * 8u;
+  }
+  return bytes;
+}
