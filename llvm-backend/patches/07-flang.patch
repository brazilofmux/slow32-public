+  // SLOW-32 aligns its 8-byte types at 4 (clang's TargetInfo; the data layout's
+  // i64:32 and f64:32) and has no long double beyond double, whatever the host's.
+  if (targetTriple.isSLOW32()) {
+    using common::TypeCategory;
+    for (TypeCategory category : {TypeCategory::Integer, TypeCategory::Unsigned,
+             TypeCategory::Logical, TypeCategory::Real}) {
+      targetCharacteristics.EnableType(category, 8, 8, 4);
+    }
+    targetCharacteristics.EnableType(TypeCategory::Complex, 8, 16, 4);
+    // No 128-bit integers: clang's target has none, so the runtime couldn't read,
+    // write or do arithmetic on them, and libs32 has no __multi3 or __divti3.
+    targetCharacteristics.DisableType(TypeCategory::Integer, 16);
+    targetCharacteristics.DisableType(TypeCategory::Unsigned, 16);
+    // docs/SPEC.md: no exception flags, no halting on them, and one rounding mode.
+    // A program that asks has to be told.  (Rounding off leaves the question to
+    // lowering: otherwise it folds to all four modes for a constant argument.)
+    using evaluate::IeeeFeature;
+    for (IeeeFeature feature : {IeeeFeature::Flags, IeeeFeature::Halting,
+             IeeeFeature::Rounding, IeeeFeature::Standard,
+             IeeeFeature::UnderflowControl}) {
+      targetCharacteristics.set_ieeeFeature(feature, false);
+    }
+    for (int kind : {2, 3, 16}) { // nothing here does half precision either
+      targetCharacteristics.DisableType(TypeCategory::Real, kind);
+      targetCharacteristics.DisableType(TypeCategory::Complex, kind);
+    }
+  }
+
   // TODO: use target machine data layout to set-up the target characteristics
