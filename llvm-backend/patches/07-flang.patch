 // NOT
+// OUT_OF_RANGE(X, MOLD [, ROUND]), real X and integer MOLD.  Semantics rewrites this
+// to arithmetic in a real wider than X (RewriteOutOfRange) and leaves it here only
+// where the target has none, as for REAL(8) with no REAL(16).
+mlir::Value IntrinsicLibrary::genOutOfRange(mlir::Type resultType,
+                                            llvm::ArrayRef<mlir::Value> args) {
+  assert(args.size() == 3);
+  mlir::Value x = args[0];
+  auto realType = mlir::cast<mlir::FloatType>(x.getType());
+  unsigned bits = args[1].getType().getIntOrFloatBitWidth();
+  // The largest magnitude of the sign that converts: the nearest real inside
+  // 2**(bits-1) less or plus MARGIN.  Rounding toward zero lands inside the limit,
+  // or exactly on it, which is one too far.
+  auto bound = [&](bool negative, const char *margin) {
+    llvm::APFloat limit(realType.getFloatSemantics());
+    limit.convertFromAPInt(llvm::APInt::getOneBitSet(bits + 1, bits - 1),
+                           /*isSigned=*/false,
+                           llvm::APFloat::rmNearestTiesToEven);
+    llvm::APFloat m(realType.getFloatSemantics(), margin);
+    llvm::APFloat::opStatus status =
+        negative ? limit.add(m, llvm::APFloat::rmTowardZero)
+                 : limit.subtract(m, llvm::APFloat::rmTowardZero);
+    if (status == llvm::APFloat::opOK)
+      limit.next(/*nextDown=*/true);
+    if (negative)
+      limit.changeSign();
+    return builder.createRealConstant(loc, realType, limit);
+  };
+  // Truncating: -128.9 and 127.9 fit an INTEGER(1).  Rounding: -128.4 and 127.4.
+  mlir::Value lo = bound(true, "1"), hi = bound(false, "0");
+  if (!isStaticallyAbsent(args, 2)) {
+    mlir::Value round =
+        builder.createConvert(loc, builder.getI1Type(), args[2]);
+    lo = mlir::arith::SelectOp::create(builder, loc, round,
+                                       bound(true, "0.5"), lo);
+    hi = mlir::arith::SelectOp::create(builder, loc, round,
+                                       bound(false, "0.5"), hi);
+  }
+  // Unordered: a NaN is out of range, as an infinity is.
+  mlir::Value below = mlir::arith::CmpFOp::create(
+      builder, loc, mlir::arith::CmpFPredicate::ULT, x, lo);
+  mlir::Value above = mlir::arith::CmpFOp::create(
+      builder, loc, mlir::arith::CmpFPredicate::UGT, x, hi);
+  mlir::Value out = mlir::arith::OrIOp::create(builder, loc, below, above);
+  return builder.createConvert(loc, resultType, out);
+}
