diff --git a/flang/include/flang/Optimizer/Support/TargetLongBytes.h b/flang/include/flang/Optimizer/Support/TargetLongBytes.h
new file mode 100644
index 000000000000..31c382973e63
--- /dev/null
+++ b/flang/include/flang/Optimizer/Support/TargetLongBytes.h
@@ -0,0 +1,22 @@
+//===-- TargetLongBytes.h - The size of the target's long -------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The models of the runtime's interfaces and of the descriptor take long and
+// size_t from the machine flang runs on, which is why flang is not supported
+// on 32-bit targets.  This build targets SLOW-32 alone (ILP32), so it says so
+// here.  std::int64_t on the host is long long on macOS; on a host where it is
+// long this is not enough.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef FORTRAN_OPTIMIZER_SUPPORT_TARGETLONGBYTES_H
+#define FORTRAN_OPTIMIZER_SUPPORT_TARGETLONGBYTES_H
+
+#define FLANG_TARGET_LONG_BYTES 4
+
+#endif
