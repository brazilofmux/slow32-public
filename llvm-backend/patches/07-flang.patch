diff --git a/flang/include/flang/Optimizer/Support/TargetModel.h b/flang/include/flang/Optimizer/Support/TargetModel.h
new file mode 100644
index 000000000000..d2d2f6350da5
--- /dev/null
+++ b/flang/include/flang/Optimizer/Support/TargetModel.h
@@ -0,0 +1,34 @@
+//===-- TargetModel.h - C types of the target, for the runtime model -*- C++ -*-//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The models of the runtime's interfaces and of the descriptor are templates
+// on the C++ types in the runtime's headers, as the machine flang runs on sees
+// them.  On a 32-bit target long, size_t and ptrdiff_t are not those sizes.
+// fir::setTargetTriple records the target here; a model takes only a context,
+// so this is per process, as a compilation has one target.
+//
+// A 64-bit target gets the host's sizes, as it always has.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef FORTRAN_OPTIMIZER_SUPPORT_TARGETMODEL_H
+#define FORTRAN_OPTIMIZER_SUPPORT_TARGETMODEL_H
+
+namespace llvm {
+class Triple;
+}
+
+namespace fir {
+void setTargetModel(const llvm::Triple &triple);
+unsigned getTargetLongBits();
+unsigned getTargetSizeBits();
+/// The target's long double is its double, whatever the host's is.
+bool targetLongDoubleIsDouble();
+} // namespace fir
+
+#endif
