+#include <atomic>
+#include <cstddef>
+
+// One target to a compilation: see TargetModel.h.  Until one is set, the host.
+static std::atomic<unsigned> targetLongBits{8 * sizeof(long)};
+static std::atomic<unsigned> targetSizeBits{8 * sizeof(std::size_t)};
+static std::atomic<bool> longDoubleIsDouble{false};
+
+void fir::setTargetModel(const llvm::Triple &triple) {
+  bool is32{triple.isArch32Bit()};
+  targetLongBits = is32 ? 32 : 8 * sizeof(long);
+  targetSizeBits = is32 ? 32 : 8 * sizeof(std::size_t);
+  longDoubleIsDouble = triple.isSLOW32();
+}
+unsigned fir::getTargetLongBits() { return targetLongBits; }
+unsigned fir::getTargetSizeBits() { return targetSizeBits; }
+bool fir::targetLongDoubleIsDouble() { return longDoubleIsDouble; }
 
 void fir::setTargetTriple(mlir::ModuleOp mod, llvm::StringRef triple) {
   auto target = fir::determineTargetTriple(triple);
+  fir::setTargetModel(llvm::Triple(target));
   mod->setAttr(mlir::LLVM::LLVMDialect::getTargetTripleAttrName(),
                mlir::StringAttr::get(mod.getContext(), target));
 }
