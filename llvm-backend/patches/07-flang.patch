+mlir::Value fir::factory::genUnsignedTripCount(mlir::OpBuilder &builder,
+                                               mlir::Location loc,
+                                               mlir::Value lb, mlir::Value ub,
+                                               mlir::Value step) {
+  using mlir::arith::CmpIPredicate;
+  mlir::Type ty = lb.getType();
+  auto constant = [&](int64_t n) -> mlir::Value {
+    return mlir::arith::ConstantOp::create(builder, loc, ty,
+                                           builder.getIntegerAttr(ty, n));
+  };
+  auto cmp = [&](CmpIPredicate p, mlir::Value a, mlir::Value b) -> mlir::Value {
+    return mlir::arith::CmpIOp::create(builder, loc, p, a, b);
+  };
+  auto choose = [&](mlir::Value c, mlir::Value a, mlir::Value b) -> mlir::Value {
+    return mlir::arith::SelectOp::create(builder, loc, c, a, b);
+  };
+  mlir::Value zero = constant(0);
+  mlir::Value down = cmp(CmpIPredicate::slt, step, zero);
+  mlir::Value empty = choose(down, cmp(CmpIPredicate::slt, lb, ub),
+                             cmp(CmpIPredicate::sgt, lb, ub));
+  mlir::Value distance =
+      choose(down, mlir::arith::SubIOp::create(builder, loc, lb, ub),
+             mlir::arith::SubIOp::create(builder, loc, ub, lb));
+  mlir::Value stride =
+      choose(down, mlir::arith::SubIOp::create(builder, loc, zero, step), step);
+  mlir::Value count = mlir::arith::AddIOp::create(
+      builder, loc,
+      mlir::arith::DivUIOp::create(builder, loc, distance, stride),
+      constant(1));
+  return choose(empty, zero, count);
+}
