# RUN: llc -mtriple=slow32-unknown-none -start-before=postrapseudos %s -o - | FileCheck %s
# REQUIRES: slow32-registered-target
#
# Post-RA expansion of PseudoLongBR materialises the target with LUI/ADDI on a
# scratch register, stamping MO_HI/MO_LO on MBB operands. MC lowering must wrap
# those as %hi/%lo so the external assembler (slow32asm) can encode them.
# Previously MBB operands dropped the flags and produced bare labels.

---
name: far
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1
    $r2 = PseudoLongBR %bb.1
  bb.1:
    RET implicit undef $r1
...

# CHECK-LABEL: far:
# CHECK: lui r2, %hi(.LBB0_1)
# CHECK-NEXT: addi r2, r2, %lo(.LBB0_1)
# CHECK-NEXT: jalr r0, r2, 0
# CHECK: .LBB0_1:
